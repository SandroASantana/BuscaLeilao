{
  "fontes": [
    {
      "id": "sodre_santoro",
      "tipo": "json",
      "nome": "Sodré Santoro",
      "url": "https://www.sodresantoro.com.br/api/search-lots",
      "metodo": "POST",
      "paginas": 200,
      "tamanho_pagina": 48,
      "corpo": {
        "indices": [
          "veiculos",
          "judiciais-veiculos",
          "sucatas"
        ],
        "query": {
          "bool": {
            "filter": [
              {
                "bool": {
                  "should": [
                    {
                      "bool": {
                        "must": [
                          {
                            "term": {
                              "auction_status": "online"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "bool": {
                        "must": [
                          {
                            "term": {
                              "auction_status": "aberto"
                            }
                          }
                        ],
                        "must_not": [
                          {
                            "terms": {
                              "lot_status_id": [
                                5,
                                7
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "bool": {
                        "must": [
                          {
                            "term": {
                              "auction_status": "encerrado"
                            }
                          },
                          {
                            "terms": {
                              "lot_status_id": [
                                6
                              ]
                            }
                          }
                        ]
                      }
                    }
                  ],
                  "minimum_should_match": 1
                }
              },
              {
                "bool": {
                  "should": [
                    {
                      "bool": {
                        "must_not": {
                          "term": {
                            "lot_status_id": 6
                          }
                        }
                      }
                    },
                    {
                      "bool": {
                        "must": [
                          {
                            "term": {
                              "lot_status_id": 6
                            }
                          },
                          {
                            "term": {
                              "segment_id": 1
                            }
                          }
                        ]
                      }
                    }
                  ],
                  "minimum_should_match": 1
                }
              },
              {
                "bool": {
                  "should": [
                    {
                      "bool": {
                        "must_not": [
                          {
                            "term": {
                              "lot_test": true
                            }
                          }
                        ]
                      }
                    }
                  ],
                  "minimum_should_match": 1
                }
              }
            ]
          }
        },
        "from": "{deslocamento}",
        "size": 48,
        "sort": [
          {
            "lot_status_id_order": {
              "order": "asc"
            }
          },
          {
            "auction_id": {
              "order": "asc"
            }
          },
          {
            "lot_number": {
              "order": "asc"
            }
          }
        ]
      },
      "caminho_lista": "results",
      "campos": {
        "id_externo": "lot_id",
        "titulo": "lot_title",
        "marca": "lot_brand",
        "modelo": "lot_model",
        "ano_fabricacao": "lot_year_manufacture",
        "ano_modelo": "lot_year_model",
        "categoria": "lot_category",
        "monta": "lot_sinister",
        "condicao": "lot_origin",
        "combustivel": "lot_fuel",
        "cor": "lot_color",
        "km": "lot_km",
        "cidade": "lot_location",
        "lance_inicial": "bid_initial",
        "lance_atual": "bid_actual",
        "data_leilao": "auction_date_init",
        "imagem_url": "lot_pictures.0",
        "descricao": "lot_description",
        "_leilao_id": "auction_id",
        "_leilao_nome": "auction_name",
        "_status": "lot_status"
      },
      "formatos": {
        "url": "https://leilao.sodresantoro.com.br/leilao/{_leilao_id}/lote/{id_externo}/",
        "leilao": "Sodré Santoro - {_leilao_nome} #{_leilao_id}"
      }
    },
